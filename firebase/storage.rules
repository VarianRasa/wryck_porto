rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /portfolio-media/{entrySlug}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "m.varianwarrick04@gmail.com";
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
